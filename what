#! /usr/bin/env bb

(require '[babashka.cli :as cli])
(require '[clojure.string :as string])
(require '[what.actions-handling :as actions])


(defn show-app-info []
  (println "what - Informações sobre commandos CLI de utilitários de sistema.\n"))


(defn show-not-implemented [_]
  (println "Ainda nao implementado."))


(def base-actions-table
  [{:cmds ["list"] :description "      Lista os comandos disponíveis." :fn actions/list-commands}
   {:cmds ["is"] :description "        Mostra a definição de um comando." :fn actions/show-command-info :opts [:command]}
   {:cmds ["doc"] :description "       Mostra a documentação de um comando." :fn actions/doc-command :opts [:command]}
   {:cmds ["find"] :description "      Procura o comando através uma string." :fn actions/find-command :opts [:query-string]}
   {:cmds ["add"] :description "       Adiciona um comando à base de dados." :fn actions/add-command :opts [:command]}
   {:cmds ["rm"] :description "        Remove um comando da base de dados." :fn actions/rm-command :opts [:command]}
   {:cmds ["upd"] :description "       Atualiza a informação de um comando na base de dados." :fn actions/upd-command :opts [:command]}
   {:cmds ["urls"] :description "      Mostra as URLs associadas a um comando." :fn actions/get-command-urls :opts [:command]}
   {:cmds ["help|h|?"] :description "  Mostra o uso do aplicativo."}
   {:cmds ["dbg"] :fn actions/debug}
   ])


(defn get-actions-descriptions
  "Print the available actions and their descriptions."
  []
  (string/join "\n"
               (for [{:keys [cmds description]} base-actions-table]
                 (let [cmd (first cmds)]
                   (when (not= cmd "dbg")
                     (str "    " cmd description))))))


(defn show-usage
  [_]
  (println (string/join "\n"
                        ["Uso: what <ação> [<nome do comando>]"
                         ""
                         "Ações:"
                         (get-actions-descriptions)])))


(def actions-table
  (let [help-cmds [["help"] ["h"] ["?"]]]
    (conj
     (vec
      (for [{:keys [cmds fn opts]}  base-actions-table]
        {:cmds cmds
         :fn (if (some #{cmds} help-cmds) show-usage fn)
         :args->opts opts}))
     {:cmds [] :fn show-usage})))


(cli/dispatch actions-table *command-line-args*)
